# syntax=docker/dockerfile:1
ARG PYTHON_VERSION=3.15
# Same uv version as in the CI (.github/workflows/docker-image.yaml)
ARG UV_VERSION=0.12.24

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv


##### BASE STAGE #####
FROM python:${PYTHON_VERSION}-alpine AS base

ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=$VIRTUAL_ENV


##### LOCK EXPORT STAGE #####
# Exports only the production dependencies. This stage re-runs on every uv.lock
# change (cheap), but its output only changes when a production dependency
# changes. As COPY --from is keyed on content, updating a dev or test
# dependency does not invalidate the venv layers below.
FROM base AS lock-export

RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv export --frozen --no-dev --no-emit-project -o /requirements.txt


##### BUILDER STAGE #####
FROM base AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0

COPY --from=lock-export /requirements.txt /tmp/requirements.txt
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv venv $VIRTUAL_ENV && \
    uv pip sync --python $VIRTUAL_ENV /tmp/requirements.txt


##### SLIM VENV STAGE #####
# Rebuilt only when dependencies change. The packages’ static files are
# collected in the static stage, Django only reads compiled .mo files, and
# fluent-compiler only needs Babel’s data for the LANGUAGES of the settings
# (checked in the production stage).
FROM builder AS venv-slim

ARG BABEL_LOCALES="en eo fr sk"

RUN find $VIRTUAL_ENV -name "*.po" -delete && \
    find $VIRTUAL_ENV/lib -type d -name static -prune \
        ! -exec test -e {}/__init__.py \; -exec rm -rf {} + && \
    find $VIRTUAL_ENV/lib -type d -name tests -prune -exec rm -rf {} + && \
    cd $VIRTUAL_ENV/lib/python*/site-packages/babel/locale-data && \
    for file in *.dat; do \
        locale="${file%.dat}"; \
        case " root $BABEL_LOCALES " in \
            *" ${locale%%_*} "*) ;; \
            *) rm "$file" ;; \
        esac; \
    done


##### DEVELOPMENT STAGE #####

FROM base AS development

ENV PYTHONDONTWRITEBYTECODE=1

COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV

RUN \
--mount=from=uv,source=/uv,target=/bin/uv \
--mount=type=cache,target=/root/.cache/uv \
--mount=type=bind,source=uv.lock,target=uv.lock \
--mount=type=bind,source=pyproject.toml,target=pyproject.toml \
uv sync --frozen

WORKDIR /app


##### STATIC STAGE #####
# collectstatic with the full venv, which still has the packages’ static files
FROM base AS static

ENV HOME="/app"

COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV
COPY src $HOME
COPY pyproject.toml uv.lock ./bin/localize_update_fields.sh $HOME/

WORKDIR $HOME

# Once collected, config/static (in STATICFILES_DIRS) only keeps what is read
# at runtime: the Vite manifest (django-vite) and the BeerCSS directory name
# (eduland_tags). The project's code is precompiled, like the venv.
RUN EDULAND_ENVIRONMENT="build" python manage.py collectstatic -v 2 --noinput && \
    find config/static -type f ! -path config/static/vue/assets/manifest.json -delete && \
    find config/static -mindepth 1 -type d -empty ! -name "beercss-*" -delete && \
    python -m compileall -q .


##### PRODUCTION STAGE #####

FROM base AS production

ARG COMMIT_HASH_TAG

ENV HOME="/app" \
    CONFIG_PREFIX="EDULAND_" \
    EDULAND_ENVIRONMENT="build" \
    EDULAND_COMMIT_HASH=$COMMIT_HASH_TAG \
    PYTHONDONTWRITEBYTECODE=1

# Granian serves the collected static files itself, the route must match STATIC_URL.
# One year of cache: file names are hashed by ManifestStaticFilesStorage or Vite.
# Backpressure 8 = 4 WSGI threads, avoids Granian's warning about too many threads.
ENV GRANIAN_INTERFACE=wsgi \
    GRANIAN_HOST=0.0.0.0 \
    GRANIAN_PORT=8000 \
    GRANIAN_LOG_ACCESS_ENABLED=true \
    GRANIAN_BACKPRESSURE=8 \
    GRANIAN_STATIC_PATH_ROUTE=/static \
    GRANIAN_STATIC_PATH_MOUNT=$HOME/staticfiles \
    GRANIAN_STATIC_PATH_EXPIRES=31536000

# --link makes these layers independent of the base layers, so they stay
# reusable when the base image changes.
COPY --link --from=venv-slim $VIRTUAL_ENV $VIRTUAL_ENV
COPY --link --from=static $HOME $HOME

WORKDIR $HOME

# Fails the build if a language of the settings has no Babel data
RUN DJANGO_SETTINGS_MODULE=config.settings python -c "import django; django.setup(); from django.conf import settings; \
from babel import Locale; [Locale.parse(code) for code, _ in settings.LANGUAGES]"

EXPOSE 8000

CMD ["granian", "config.wsgi:application"]
